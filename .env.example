# ── Visitor counter (Supabase) ─────────────────────────────────────────────
# The floating visitor counter is backed by a Supabase Postgres table so the
# number persists across page refreshes and server restarts. Create a free
# project at https://supabase.com, then run the SQL in README.md, and paste
# the values below (or set them in your Vercel project's Environment
# Variables). Without these, the counter falls back to a temporary in-memory
# count that resets on server restart — fine for local preview, not for
# production.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
